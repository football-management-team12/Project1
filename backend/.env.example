# Local SQL Server (change to the address of your own instance)
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=127.0.0.1,1433
DB_NAME=FootballBookingDB
DB_TRUSTED_CONNECTION=no
DB_USER=YOUR_SQL_USER
DB_PASSWORD=YOUR_SQL_PASSWORD
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=yes

# For Windows Authentication, set DB_TRUSTED_CONNECTION=yes and
# DB_SERVER=YOUR_PC\SQLEXPRESS, and omit DB_USER and DB_PASSWORD.

