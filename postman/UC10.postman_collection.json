{
  "info": {
    "name": "UC10 - T123-66 Reviews",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Apply migration 011 first. Use dedicated fixtures. Valid POST writes one review; use a fresh COMPLETED booking owned by the CUSTOMER. Do not use production customer data."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5001"
    },
    {
      "key": "customerToken",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": "1001"
    },
    {
      "key": "ineligibleBookingId",
      "value": "1002"
    },
    {
      "key": "otherBookingId",
      "value": "1003"
    },
    {
      "key": "fieldId",
      "value": "5"
    }
  ],
  "item": [
    {
      "name": "Booking eligibility",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/bookings/{{bookingId}}/reviews"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON response\", () => pm.response.json());"
            ]
          }
        }
      ]
    },
    {
      "name": "Submit valid review - fresh booking required",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/bookings/{{bookingId}}/reviews",
        "body": {
          "mode": "raw",
          "raw": "{\"rating\": 5, \"comment\": \"Sân tốt, đúng giờ\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", () => pm.response.to.have.status(201));",
              "pm.test(\"JSON response\", () => pm.response.json());"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject duplicate",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/bookings/{{bookingId}}/reviews",
        "body": {
          "mode": "raw",
          "raw": "{\"rating\": 5, \"comment\": \"Duplicate test\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", () => pm.response.to.have.status(409));",
              "pm.test(\"JSON response\", () => pm.response.json());"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject rating 0",
      "request": {
