              "pm.test(\"JSON response\", () => pm.response.json());"
            ]
          }
        }
      ]
    },
    {
      "name": "Public field reviews",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/fields/{{fieldId}}/reviews?page=1&pageSize=10"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", () => pm.response.to.have.status(200));",
