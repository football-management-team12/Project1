  "item": [
    {
      "name": "Customer own invoice",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{customerToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/invoices/{{invoiceId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test('Amounts reconcile', () => { pm.expect(data.totalAmount).to.eql(data.paidAmount + data.remainingAmount); pm.expect(data.depositAmount).to.be.at.most(data.paidAmount); });",
              "pm.test('Payment status', () => pm.expect(data.paymentStatus).to.eql(data.remainingAmount === 0 ? 'PAID' : data.paidAmount > 0 ? 'PARTIALLY_PAID' : 'UNPAID'));",
              "pm.test('Jira response contract', () => { const data = pm.response.json(); pm.expect(data).to.have.property('paymentStatus'); pm.expect(data.field).to.have.all.keys('fieldId', 'fieldName', 'fieldType', 'location'); });"
            ]
          }
        }
      ]
    },
