{
  "info": {
    "name": "UC08 - Invoice View (read-only)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Use existing test data only. No seed, mutation, login or secret is included. Customer token owns invoiceId and bookingId; customerBToken is a different customer. Set IDs for payment states and missing records."
  },
