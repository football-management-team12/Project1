              "pm.test(\"JSON body\", () => pm.response.json());",
              "pm.test(\"No password hash in response\", () => pm.expect(pm.response.text().toLowerCase()).not.to.include(\"passwordhash\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Partial name update - dedicated fixture only",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/api/admin/customers/{{customerId}}",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"fullName\": \"QA Customer Updated\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
