{
  "info": {
    "name": "UC13 - T123-64 Customer Management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "No migration required. Use dedicated QA customers: valid PUT updates contact data. Set a duplicateEmail belonging to another account. Do not use production customer records."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5001"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "customerToken",
      "value": ""
    },
    {
      "key": "customerId",
      "value": "1001"
    },
    {
      "key": "keyword",
      "value": "QA"
    },
    {
      "key": "duplicateEmail",
      "value": "existing-qa@example.invalid"
    }
  ],
  "item": [
    {
      "name": "List customers",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/admin/customers?page=1&pageSize=10",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON body\", () => pm.response.json());",
              "pm.test(\"No password hash in response\", () => pm.expect(pm.response.text().toLowerCase()).not.to.include(\"passwordhash\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Search customers",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/admin/customers?keyword={{keyword}}",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON body\", () => pm.response.json());",
              "pm.test(\"No password hash in response\", () => pm.expect(pm.response.text().toLowerCase()).not.to.include(\"passwordhash\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Filter inactive",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/admin/customers?status=INACTIVE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON body\", () => pm.response.json());",
              "pm.test(\"No password hash in response\", () => pm.expect(pm.response.text().toLowerCase()).not.to.include(\"passwordhash\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Customer detail",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/admin/customers/{{customerId}}",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
