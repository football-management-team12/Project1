              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"FieldType\": \"5 player\",\n  \"Location\": \"Review location\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Array body - expect 400",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/admin/fields",
            "description": "JSON must be an object.",
            "header": [
              {
                "key": "Content-Type",
