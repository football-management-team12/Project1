  "item": [
    {
      "name": "01 - List all fields",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/admin/fields"
      }
    },
    {
      "name": "02 - List non-archived fields",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/admin/fields?archived=0"
      }
    },
    {
      "name": "03 - List archived fields",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/admin/fields?archived=1"
      }
    },
    {
      "name": "04 - Field detail and prices",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/admin/fields/{{fieldId}}"
      }
    },
    {
      "name": "05 - Create field (copy returned FieldID to fieldId)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/admin/fields",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"FieldName\": \"UC15 review field\",\n  \"FieldType\": \"5 player\",\n  \"Location\": \"Review location\",\n  \"Image\": \"\",\n  \"Status\": \"AVAILABLE\"\n}"
        }
      }
    },
    {
      "name": "06 - Update field",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/api/admin/fields/{{fieldId}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"FieldName\": \"UC15 review field updated\",\n  \"Location\": \"Updated location\"\n}"
        }
      }
    },
    {
      "name": "07 - Set maintenance",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/admin/fields/{{fieldId}}/status",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"Status\":\"MAINTENANCE\"}"
        }
      }
    },
    {
      "name": "08 - Set available",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/admin/fields/{{fieldId}}/status",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"Status\":\"AVAILABLE\"}"
        }
      }
    },
    {
      "name": "09 - Archive field (409 if active bookings exist)",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/admin/fields/{{fieldId}}/archive"
      }
    },
    {
      "name": "10 - Restore field (preserve status and archive metadata)",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/admin/fields/{{fieldId}}/restore"
      }
    },
    {
      "name": "11 - Add price (copy result.PriceID to priceId)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/admin/fields/{{fieldId}}/prices",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"StartTime\": \"06:00\",\n  \"EndTime\": \"07:00\",\n  \"Price\": 300000\n}"
        }
      }
    },
    {
      "name": "12 - Update one price",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/api/admin/fields/{{fieldId}}/prices/{{priceId}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"StartTime\": \"06:00\",\n  \"EndTime\": \"07:00\",\n  \"Price\": 350000\n}"
        }
      }
    },
    {
      "name": "Authorization - prepare valid role/status fixtures",
      "item": [
        {
          "name": "Missing JWT - expect 401",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/fields",
            "description": "No Authorization header. No database changes.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Malformed JWT - expect 401",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/fields",
            "description": "Deliberately invalid token; not an expired-token substitute.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "intentionally-invalid-token",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Expired JWT - expect 401",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/fields",
            "description": "Set expiredAdminToken to a genuinely expired signed token.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{expiredAdminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "CUSTOMER denied - expect 403",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/fields",
            "description": "Set customerToken to a valid CUSTOMER token; an empty/invalid token gives 401.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Inactive ADMIN denied - expect 403",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/fields",
            "description": "Use a valid ADMIN token whose user is INACTIVE in the QA database. Do not deactivate a real account.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{inactiveAdminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Legacy price also checks ACTIVE - expect 403",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/fields/price/{{fieldId}}",
            "description": "Use a real fieldId and valid inactiveAdminToken; verify prices are unchanged.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{inactiveAdminToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"StartTime\": \"{{bookingStartTime}}\",\n  \"EndTime\": \"{{bookingEndTime}}\",\n  \"Price\": 300000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Validation - valid active ADMIN token required",
      "item": [
        {
          "name": "Unsupported FieldType on create - expect 400",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/admin/fields",
            "description": "9 player is outside the supported enum; no field is inserted.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"FieldName\": \"UC15 review field\",\n  \"FieldType\": \"9 player\",\n  \"Location\": \"Review location\",\n  \"Image\": \"\",\n  \"Status\": \"AVAILABLE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Unsupported FieldType on update - expect 400",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/admin/fields/{{fieldId}}",
            "description": "Existing non-archived field; compare FieldType before/after.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"FieldType\": \"9 player\"\n}",
              "options": {
