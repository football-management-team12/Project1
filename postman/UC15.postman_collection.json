{
  "info": {
    "name": "UC15 - Field management (T123-74)",
    "description": "Manual UC15 API requests (no scripts/assertion events). Import a copy, set tokens and fixture IDs, then send selected requests. Do not run the collection as one sequential scenario: negative, rollback and race groups have different preconditions. JWT variables must contain real valid tokens for the stated role/status. Rollback requires a controlled SQL fault in a separate QA database; concurrency requires parallel sessions. Never inject faults into a shared/live database. Responses and SQL evidence must be recorded by Tester T123-137. No DELETE endpoint is in scope. FieldType accepts only 5 player, 7 player, 11 player.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{adminToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5001"
    },
