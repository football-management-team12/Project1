            "description": "Use a field without active bookings; verify price rows unchanged.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"StartTime\": \"{{bookingStartTime}}\",\n  \"EndTime\": \"{{bookingEndTime}}\",\n  \"Price\": -1\n}",
