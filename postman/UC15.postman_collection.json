        {
          "name": "Invalid time - expect 400",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/admin/fields/{{fieldId}}/prices",
            "description": "25:00 is outside valid local time.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"StartTime\": \"25:00\",\n  \"EndTime\": \"{{bookingEndTime}}\",\n  \"Price\": 300000\n}",
