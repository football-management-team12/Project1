  "item": [
    {
      "name": "01 Admin — báo cáo khoảng ngày",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/admin/reports/summary?from={{from}}&to={{to}}",
        "description": "Read-only. Chạy trên QA riêng với token tương ứng. Công thức và fixture: docs/UC16-statistics-reports.md. Không mặc định dữ liệu deploy trùng fixture SQL."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "const b=pm.response.json();",
              "pm.test('Contract and cash equation',()=>{pm.expect(b.currency).eq('VND');pm.expect(b).not.to.have.property('paymentStatusCount');pm.expect(Object.keys(b.bookingStatusCount).every(s=>s==='COMPLETED')).eq(true);pm.expect(b.revenue).closeTo(b.grossRevenue-b.refundedAmount,0.01);pm.expect(b.fieldUtilization).to.be.an('array');pm.expect(b.dailyRevenue.length).eq(b.dayCount);});",
              "pm.test('Daily totals reconcile',()=>{for(const k of ['revenue','grossRevenue','refundedAmount'])pm.expect(b.dailyRevenue.reduce((s,r)=>s+r[k],0)).closeTo(b[k],0.01);});",
              "pm.test('Booking breakdown reconciles without counting deposits as completed',()=>{const c=b.bookingBreakdown;pm.expect(c.completedPaid).eq(b.bookingCount);pm.expect(Object.entries(c).filter(([k])=>k!=='total').reduce((s,[,v])=>s+v,0)).eq(c.total);});",
              "pm.test('Counts and utilization reconcile',()=>{pm.expect(Object.values(b.bookingStatusCount).reduce((a,v)=>a+v,0)).eq(b.bookingCount);pm.expect(Object.values(b.invoiceStatusCount).reduce((a,v)=>a+v,0)).eq(b.invoiceCount);b.fieldUtilization.forEach(f=>{pm.expect(f.capacityHours).eq(b.dayCount*24);pm.expect(f.utilizationPercent).within(0,100);});});"
            ]
          }
        }
      ]
    },
