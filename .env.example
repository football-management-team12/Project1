# Placeholder values only. Do not copy real credentials into Git.
DB_SERVER=replace-with-server
DB_NAME=replace-with-database
DB_USER=replace-with-user
DB_PASSWORD=replace-with-password
JWT_SECRET=replace-with-random-secret
FRONTEND_URL=https://replace-with-frontend-domain
GMAIL_SENDER_EMAIL=replace-with-sender@gmail.com
OTP_HASH_SECRET=replace-with-independent-random-secret-at-least-32-bytes
# Choose JSON OR a read-only mounted file, never both.
GOOGLE_GMAIL_TOKEN_FILE=/run/secrets/gmail_token.json
# GOOGLE_GMAIL_TOKEN_JSON={"client_id":"placeholder","client_secret":"placeholder","refresh_token":"placeholder","scopes":["https://www.googleapis.com/auth/gmail.send"]}
