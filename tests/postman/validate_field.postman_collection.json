{
  "info": {
    "name": "Validate Field and Price Data with Auto Login",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00_Auto Login Admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "var token = jsonData.accessToken || jsonData.token || (jsonData.data && (jsonData.data.accessToken || jsonData.data.token));",
              "if (token) {",
              "    pm.environment.set(\"accessToken\", token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"account\": \"user1\",\n    \"password\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "04_3_Validate cac truong thong tin",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var caseName = pm.iterationData.get(\"case_name\") || \"Test case\";",
              "var reqBody = JSON.stringify(pm.iterationData.toObject());",
              "var jsonData = pm.response.json();",
              "var resBody = JSON.stringify(jsonData);",
              "pm.test(\"[TC Field: \" + caseName + \"] ==> Status 400\", function () {",
              "    pm.response.to.have.status(400);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"FieldName\": \"{{FieldName}}\",\n    \"Location\": \"{{Location}}\",\n    \"FieldType\": \"{{FieldType}}\",\n    \"Image\": \"{{Image}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/admin/fields/{{fieldId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "fields", "{{fieldId}}"]
        }
      }
    },
    {
      "name": "04_4_Validate gia va thoi gian",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var caseName = pm.iterationData.get(\"case_name\") || \"Test case\";",
              "var jsonData = pm.response.json();",
              "var resBody = JSON.stringify(jsonData);",
              "pm.test(\"[TC Price: \" + caseName + \"] ==> Status 400\", function () {",
              "    pm.response.to.have.status(400);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"StartTime\": \"{{StartTime}}\",\n    \"EndTime\": \"{{EndTime}}\",\n    \"Price\": {{Price}}\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/admin/fields/{{fieldId}}/prices",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "fields", "{{fieldId}}", "prices"]
        }
      }
    },
    {
        "name": "Kiểm tra trùng/giao/bao chứa khung giờ",
        "event": [
            {
            "listen": "test",
            "script": {
                "exec": [
                "var caseName = pm.iterationData.get(\"case_name\") || \"Test case\";",
                "var jsonData = pm.response.json();",
                "var resBody = JSON.stringify(jsonData);",
                "pm.test(\"[TC Overlap: \" + caseName + \"] ==> Status 409\", function () {",
                "    pm.response.to.have.status(409);",
                "});"
                ],
                "type": "text/javascript"
            }
            }
        ],
        "request": {
            "method": "POST",
            "header": [
            {
                "key": "Content-Type",
                "value": "application/json"
            },
            {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
            }
            ],
            "body": {
            "mode": "raw",
            "raw": "{\n    \"StartTime\": \"{{StartTime}}\",\n    \"EndTime\": \"{{EndTime}}\",\n    \"Price\": {{Price}}\n}"
            },
            "url": {
            "raw": "{{baseUrl}}/api/admin/fields/{{fieldId}}/prices",
            "host": ["{{baseUrl}}"],
            "path": ["api", "admin", "fields", "{{fieldId}}", "prices"]
            }
        }
    }
  ]
}